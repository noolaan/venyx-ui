	-- functions
	
	function library:setTheme(theme, color3)
		local old = themes[theme]
		themes[theme] = color3

		-- Accent and LightContrast start out as the same color, so parts made with either are recolored together
		for property, set in pairs(objects[theme] or {}) do
			for object in pairs(set) do
				if not object.Parent or (object.Name == "Button" and object.Parent.Name == "ColorPicker") then
					set[object] = nil
				elseif object[property] == old then -- skip anything that's been recolored since
					object[property] = color3
				end
			end
		end
	end

	function library:toggle()

		local container = self.container:FindFirstChild("Main")
		if self.toggling or not container then
			return
		end

		self.toggling = true

		local topbar = container.TopBar
		local modal = container.Modal

		if self.position then
			modal.Modal = true
			utility:Tween(container, {
				Size = self.size or UDim2.new(0, 511, 0, 428), -- the size it had before closing (it can be resized)
				Position = self.position
			}, 0.2)
			task.wait(0.2)

			utility:Tween(topbar, {Size = UDim2.new(1, 0, 0, 38)}, 0.2)
			task.wait(0.2)

			container.ClipsDescendants = false
			self.position = nil
		else
			self.position = container.Position
			self.size = container.Size
			container.ClipsDescendants = true
			modal.Modal = false

			utility:Tween(topbar, {Size = UDim2.new(1, 0, 1, 0)}, 0.2)
			task.wait(0.2)

			utility:Tween(container, {
				Size = UDim2.new(0, self.size.X.Offset, 0, 0),
				Position = self.position + UDim2.new(0, 0, 0, self.size.Y.Offset)
			}, 0.2)
			task.wait(0.2)
		end

		self.toggling = false
	end
	
	-- new modules
	
	-- Notify and ImageNotify return right away; the animations run in their own thread (they used to make the caller
	-- wait up to ~0.6s). One shows at a time, in order, so two at once can't both close the same previous one and
	-- leave one stuck on screen.
	local function queueNotification(self, show, ...)
		local args = table.pack(...)
		task.spawn(function()
			while self.notifying do
				task.wait()
			end
			self.notifying = true
			local ok, err = pcall(show, self, table.unpack(args, 1, args.n))
			self.notifying = false
			if not ok then
				warn("[venyx] notification failed: " .. tostring(err))
			end
		end)
	end

	function library:Notify(...)
		queueNotification(self, self.showNotification, ...)
	end

	function library:ImageNotify(...)
		queueNotification(self, self.showImageNotification, ...)
	end

