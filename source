			Size = UDim2.new(0, toastWidth, 0, height),
			ZIndex = 3,
			Image = "rbxassetid://5028857472",
			ImageColor3 = themes.Background,
			ScaleType = Enum.ScaleType.Slice,
			SliceCenter = Rect.new(4, 4, 296, 296)
		}, {
			utility:Create("ImageLabel", {
				Name = "Glow",
				BackgroundTransparency = 1,
				Position = UDim2.new(0, -15, 0, -15),
				Size = UDim2.new(1, 30, 1, 30),
				ZIndex = 2,
				Image = "rbxassetid://5028857084",
				ImageColor3 = themes.Glow,
				ScaleType = Enum.ScaleType.Slice,
				SliceCenter = Rect.new(24, 24, 276, 276)
			}),
			utility:Create("TextLabel", {
				Name = "Title",
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0, 8),
				Size = UDim2.new(1, -20, 0, 16),
				ZIndex = 4,
				Font = Enum.Font.GothamSemibold,
				Text = title,
				TextColor3 = themes.TextColor,
				TextSize = 14,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left
			}),
			utility:Create("TextLabel", {
				Name = "Text",
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0, 28),
				Size = UDim2.new(1, -20, 0, textHeight),
				ZIndex = 4,
				Font = Enum.Font.Gotham,
				Text = text,
				TextColor3 = themes.TextColor,
				TextSize = 12,
				TextTransparency = 0.1,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top
			}),
			utility:Create("Frame", { -- shrinks as the time runs out
				Name = "Timer",
				BackgroundColor3 = themes.TextColor,
				BackgroundTransparency = 0.5,
				BorderSizePixel = 0,
				Position = UDim2.new(0, 4, 1, -4),
				Size = UDim2.new(1, -8, 0, 2),
				ZIndex = 4
			})
		})

		table.insert(self.toasts, toast)
		if #self.toasts > toastLimit then
			dismissToast(self, self.toasts[1])
		end
		layoutToasts(self)

		utility:Tween(toast.Timer, {Size = UDim2.new(0, 0, 0, 2)}, duration, Enum.EasingStyle.Linear)
		toast.MouseButton1Click:Connect(function()
			dismissToast(self, toast)
		end)
		task.delay(duration, dismissToast, self, toast)

		return toast
	end
	
