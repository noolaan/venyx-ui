	local function sliderDecimals(options)
		local decimals = tostring(options.step):match("%.(%d+)$")
		return decimals and #decimals or 0
	end

	-- Trim to the step's decimal places (0.1 + 0.2 lands on 0.3, not 0.30000000000000004)
	local function roundSlider(options, value)
		local scale = 10 ^ sliderDecimals(options)
		return math.floor(value * scale + 0.5) / scale + 0 -- + 0: no "-0"
	end

	local function formatSlider(options, value, bare)
		return string.format("%." .. sliderDecimals(options) .. "f", value) .. (bare and "" or options.suffix)
	end

