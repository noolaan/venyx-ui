	-- One hover label per window, following the mouse; `owner` is the cell it's showing for
	local function showTooltip(library, owner, text)
		local tooltip = library.tooltip
		if not tooltip or not tooltip.Parent then
			tooltip = utility:Create("TextLabel", {
				Name = "Tooltip",
				Parent = library.container,
				AutomaticSize = Enum.AutomaticSize.XY,
				BackgroundColor3 = themes.DarkContrast,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 0, 0, 0),
				ZIndex = 50,
				Font = Enum.Font.Gotham,
				Text = "",
				TextColor3 = themes.TextColor,
				TextSize = 12,
				Visible = false
			}, {
				utility:Create("UICorner", {CornerRadius = UDim.new(0, 4)}),
				utility:Create("UIPadding", {
					PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
					PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)
				})
			})
			library.tooltip = tooltip
		end

		library.tooltipOwner = owner
		tooltip.Text = text
		tooltip.Visible = true

		-- below-right of the mouse, flipped left near the screen's right edge
		local x, y = mouse.X + 14, mouse.Y + 16
		if x + tooltip.AbsoluteSize.X > library.container.AbsoluteSize.X then
			x = mouse.X - 8 - tooltip.AbsoluteSize.X
		end
		tooltip.Position = UDim2.new(0, x, 0, y)
	end

	local function hideTooltip(library, owner)
		if library.tooltip and (owner == nil or library.tooltipOwner == owner) then
			library.tooltip.Visible = false
			library.tooltipOwner = nil
		end
	end

	-- Pick one of `items` by its picture. Each item is {name = "Iron Helmet", image = "rbxassetid://..." or an id,
	-- value = anything (defaults to name)}; the name shows on hover and is what the box searches. An item without an
	-- image shows its name in the cell instead. An item's `inset` (a fraction of the cell, like 0.25) pads its icon. `selected` is the starting pick's value. callback(value, update).
	-- options: size (cell edge, default 44), rows (rows shown before it scrolls, default 3), prefix (the box reads
	-- "title: pick" instead of just the pick, for several grids in one section), multi (pick any number: `selected`
	-- is an array of values, a click toggles a cell and leaves the grid open, and callback gets the new array).
	local imageGrids = setmetatable({}, {__mode = "k"}) -- grid -> its state

	local function toImage(image)
		if type(image) == "number" then
			return "rbxassetid://" .. image
		end
		return image or ""
	end

	local function itemValue(item)
		if item.value == nil then
			return item.name
		end
		return item.value
	end

	local function gridItem(state, value)
		for _, item in ipairs(state.items) do
			if itemValue(item) == value then
				return item
			end
		end
	end

	local function isPicked(state, value)
		if state.multi then
			return table.find(state.selected, value) ~= nil
		end
		return value == state.selected
	end

	-- Size the open grid to its visible cells (at most state.rows rows, scrolling past that), or close it
	local function layoutImageGrid(state, quiet)
		local grid, frame = state.grid, state.grid.List.Frame
		local cell, pad = state.size, 4
		local scale = utility:GetScale(frame)
		local width = frame.AbsoluteSize.X / scale - 6 -- the UIPadding keeps the scrollbar off the cells
		local columns = math.max(1, math.floor((width + pad) / (cell + pad)))

		local shown = 0
		for _, button in pairs(state.cells) do
			if button.Visible then
				shown = shown + 1
			end
		end

		state.columns = columns
		local rows = math.ceil(shown / columns)
		local content = math.max(0, rows * (cell + pad) - pad)
		local window = math.min(rows, state.rows) * (cell + pad) - pad
		local height = 30
		if state.open then
			height = 34 + 8 + math.max(window, 30)
		end

		frame.CanvasSize = UDim2.new(0, 0, 0, content)
		frame.ScrollBarImageTransparency = rows > state.rows and 0 or 1
		grid.List.Empty.Visible = state.open and shown == 0

		if quiet then
			grid.Size = UDim2.new(1, 0, 0, height)
		else
			utility:Tween(grid, {Size = UDim2.new(1, 0, 0, height)}, 0.3)
		end
		return height
	end

	local function setGridLabel(state)
		local item, name
		if state.multi then
			-- "title: A, B, C", like a multi dropdown; the preview shows the first pick
			local names = {}
			for _, value in ipairs(state.selected) do
				local picked = gridItem(state, value)
				item = item or picked
				table.insert(names, picked and tostring(picked.name) or tostring(value))
			end
			name = #names > 0 and state.title .. ": " .. table.concat(names, ", ") or nil
		else
			item = gridItem(state, state.selected)
			name = item and tostring(item.name)
			if name and state.prefix then
				name = state.title .. ": " .. name
			end
		end
		local search = state.grid.Search
		if not search.TextBox:IsFocused() then
			search.TextBox.Text = name or state.title
		end
		search.Preview.Image = item and toImage(item.image) or ""
		search.Preview.Visible = item ~= nil and item.image ~= nil
		search.TextBox.Position = UDim2.new(0, search.Preview.Visible and 34 or 10, 0.5, 1)
		search.TextBox.Size = UDim2.new(1, search.Preview.Visible and -66 or -42, 1, 0)

		for i, button in pairs(state.cells) do
			button.Outline.Enabled = isPicked(state, itemValue(state.items[i]))
		end
	end

	local function buildImageGrid(self, state)
		local frame = state.grid.List.Frame
		for _, button in pairs(state.cells) do
			button:Destroy()
		end
		state.cells = {}

		for i, item in ipairs(state.items) do
			local value = itemValue(item)
			local image = item.image ~= nil
			-- gap around the icon: item.inset is a fraction of the cell's edge, for icons that fill their whole image
			local gap = item.inset and math.floor(state.size * item.inset) or (image and 3 or 2)
			local function placeIcon(icon, hovered)
				local pad = hovered and math.max(0, gap - 2) or gap
				icon.Position = UDim2.new(0, pad, 0, pad)
				icon.Size = UDim2.new(1, -2 * pad, 1, -2 * pad)
			end
			local button = utility:Create("ImageButton", {
				Name = tostring(item.name),
				Parent = frame,
				LayoutOrder = i,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 3,
				AutoButtonColor = false,
				Image = "rbxassetid://5028857472",
				ImageColor3 = themes.DarkContrast,
				ScaleType = Enum.ScaleType.Slice,
				SliceCenter = Rect.new(2, 2, 298, 298)
			}, {
				utility:Create("UIStroke", {
					Name = "Outline", -- not "Selected": that's an ImageButton property
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					BorderStrokePosition = Enum.BorderStrokePosition.Inner, -- edge cells would clip an outside stroke
					Color = themes.TextColor,
					Thickness = 1.5,
					Enabled = false
				}),
				image and utility:Create("ImageLabel", {
					Name = "Icon",
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 3, 0, 3),
					Size = UDim2.new(1, -6, 1, -6),
					ZIndex = 4,
					Image = toImage(item.image),
					ScaleType = Enum.ScaleType.Fit
				}) or utility:Create("TextLabel", {
					Name = "Icon",
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 2, 0, 2),
					Size = UDim2.new(1, -4, 1, -4),
					ZIndex = 4,
					Font = Enum.Font.Gotham,
					Text = tostring(item.name),
					TextColor3 = themes.TextColor,
					TextSize = 10,
					TextWrapped = true,
					TextTransparency = 0.1
				})
			})
			state.cells[i] = button
			placeIcon(button.Icon, false)

			button.MouseEnter:Connect(function()
				placeIcon(button.Icon, true)
				showTooltip(self.page.library, button, tostring(item.name))
			end)
			button.MouseMoved:Connect(function()
				showTooltip(self.page.library, button, tostring(item.name))
			end)
			button.MouseLeave:Connect(function()
				placeIcon(button.Icon, false)
				hideTooltip(self.page.library, button)
			end)

			button.MouseButton1Click:Connect(function()
				if state.multi then
					local index = table.find(state.selected, value)
					if index then
						table.remove(state.selected, index)
					else
						table.insert(state.selected, value)
					end
					setGridLabel(state)
					if state.callback then
						state.callback(table.clone(state.selected), function(...)
							self:updateImageGrid(state.grid, ...)
						end)
					end
					return
				end
				state.selected = value
				state.open = false
				hideTooltip(self.page.library)
				setGridLabel(state)
				utility:Pop(state.grid.Search, 10)
				utility:Tween(state.grid.Search.Button, {Rotation = 0}, 0.3)
				layoutImageGrid(state)

				if state.callback then
					state.callback(value, function(...)
						self:updateImageGrid(state.grid, ...)
					end)
				end
			end)
		end
	end

	local function filterImageGrid(state, pattern)
		pattern = (pattern or ""):lower()
		for i, item in ipairs(state.items) do
			local button = state.cells[i]
			if button then
				button.Visible = pattern == "" or tostring(item.name):lower():find(pattern, 1, true) ~= nil
			end
		end
	end

	local function openImageGrid(self, state, open)
		state.open = open
		utility:Pop(state.grid.Search, 10)
		utility:Tween(state.grid.Search.Button, {Rotation = open and 180 or 0}, 0.3)
		if not open then
			hideTooltip(self.page.library)
		end
		if open and not state.built then
			state.built = true
			buildImageGrid(self, state)
			setGridLabel(state)
		end

		local height = layoutImageGrid(state)
		if open then
			state.grid.List.Frame.CanvasPosition = Vector2.new(0, 0)
			-- start scrolled to the pick, when there is one
			local index = 0
			for i, item in ipairs(state.items) do
				if state.cells[i] and state.cells[i].Visible then
					index = index + 1
					if isPicked(state, itemValue(item)) then
						local row = math.floor((index - 1) / state.columns)
						local frame = state.grid.List.Frame -- a row above it shows; CanvasPosition is in screen pixels
						utility:ScrollTo(frame, (row - 1) * (state.size + 4) * utility:GetScale(frame), 0.35)
						break
					end
				end
			end
			self:ScrollIntoView(state.grid, height)
		end
	end

