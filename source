			["."] = true,
			["-."] = true
		}
		
		local textbox = slider.TextBox
		local circle = slider.Slider.Bar.Fill.Circle
		
		local value = default or min
		local dragging, last
		
		local callback = function(value)
			if callback then
				callback(value, function(...)
					self:updateSlider(slider, ...)
				end)
			end
		end
		
		value = self:updateSlider(slider, nil, value, min, max)
		
		utility:DraggingEnded(function()
			dragging = false
		end)

		slider.MouseButton1Down:Connect(function(input)
			dragging = true
			utility:Tween(circle, {ImageTransparency = 0}, 0.1)

			while dragging do
				-- only when it moves: holding the bar still used to call back every frame
				local newValue = self:updateSlider(slider, nil, nil, nil, nil, value)
				if newValue ~= value then
					value = newValue
					callback(value)
				end

				utility:Wait()
			end
			
			task.wait(0.5)
			if not dragging then -- grabbed again in the meantime: keep the knob showing
				utility:Tween(circle, {ImageTransparency = 1}, 0.2)
			end
		end)
		
		-- self.sliders[slider].value is the current value, even if code moved the slider with updateSlider
		local state = self.sliders[slider]

		textbox.Focused:Connect(function()
			textbox.Text = formatSlider(state, state.value, true) -- no suffix while typing
		end)

		textbox.FocusLost:Connect(function()
			if not tonumber(textbox.Text) then
				value = self:updateSlider(slider, nil, default or min, nil, nil)
				callback(value)
			else
				self:updateSlider(slider, nil, state.value, nil, nil, state.value) -- put the suffix back
			end
		end)
		
		-- Only while you're typing in the box. updateSlider writes this box too, so dragging (and any updateSlider call
		-- from code) used to call back a second time through here.
		textbox:GetPropertyChangedSignal("Text"):Connect(function()
			if not textbox:IsFocused() then
				return
			end
			local text = textbox.Text

			if not allowed[text] and not tonumber(text) then
				textbox.Text = text:sub(1, #text - 1)
			elseif not allowed[text] and tonumber(text) ~= state.value then -- (focusing rewrites the box without changing it)
				value = self:updateSlider(slider, nil, tonumber(text), nil, nil)
				callback(value)
			end
		end)

		return slider
	end
	
