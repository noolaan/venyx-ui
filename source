					Position = UDim2.new(0, 4, 0, 4),
					Size = UDim2.new(1, -8, 1, -8),
					CanvasSize = UDim2.new(0, 0, 0, 0),
					ZIndex = 2,
					ScrollBarThickness = 3,
					ScrollBarImageColor3 = themes.DarkContrast
				}, {
					utility:Create("UIGridLayout", {
						SortOrder = Enum.SortOrder.LayoutOrder,
						CellSize = UDim2.new(0, size, 0, size),
						CellPadding = UDim2.new(0, 4, 0, 4)
					}),
					utility:Create("UIPadding", {
						PaddingRight = UDim.new(0, 6)
					})
				}),
				utility:Create("TextLabel", {
					Name = "Empty",
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 10, 0, 4),
					Size = UDim2.new(1, -20, 0, 30),
					ZIndex = 3,
					Font = Enum.Font.Gotham,
					Text = "Nothing found",
					TextColor3 = themes.TextColor,
					TextSize = 12,
					TextTransparency = 0.5,
					TextXAlignment = Enum.TextXAlignment.Left,
					Visible = false
				})
			})
		})

		table.insert(self.modules, grid)
		utility:SmoothScroll(grid.List.Frame, (size + 4) / 2) -- half a row per notch

		local state = {
			grid = grid,
			title = title,
			items = items or {},
			selected = options.multi and table.clone(selected or {}) or selected,
			callback = callback,
			size = size,
			rows = options.rows or 3,
			prefix = options.prefix == true,
			multi = options.multi == true,
			open = false,
			built = false,
			cells = {}
		}
		imageGrids[grid] = state
		setGridLabel(state)

		local search = grid.Search
		local focused

		search.Button.MouseButton1Click:Connect(function()
			if not state.open then
				filterImageGrid(state, "")
			end
			openImageGrid(self, state, not state.open)
		end)

		search.TextBox.Focused:Connect(function()
			focused = true
			search.TextBox.Text = ""
			if not state.open then
				openImageGrid(self, state, true)
			end
		end)

		search.TextBox.FocusLost:Connect(function()
			focused = false
			setGridLabel(state) -- the filter stays until it's reopened
		end)

		search.TextBox:GetPropertyChangedSignal("Text"):Connect(function()
			if focused and state.built then
				filterImageGrid(state, search.TextBox.Text)
				grid.List.Frame.CanvasPosition = Vector2.new(0, 0)
				layoutImageGrid(state)
			end
		end)

		-- the window being resized changes how many cells fit in a row
		grid.List.Frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if state.open then
				layoutImageGrid(state, true)
			end
		end)

		grid:GetPropertyChangedSignal("Size"):Connect(function()
			self:Resize()
		end)

		grid.Destroying:Connect(function()
			hideTooltip(self.page.library)
		end)

		return grid
	end

	-- Set an image grid's pick (a value, or an array for a multi grid) without calling its callback, and/or replace
	-- its items. Either can be nil.
	function section:updateImageGrid(grid, selected, items)
		grid = self:getModule(grid)
		local state = imageGrids[grid]

		if items then
			state.items = items
			if state.built then
				buildImageGrid(self, state)
				if state.open then
					local search = grid.Search.TextBox
					filterImageGrid(state, search:IsFocused() and search.Text or "")
				end
				layoutImageGrid(state, true)
			end
		end
		if selected ~= nil then
			state.selected = state.multi and table.clone(selected) or selected
		end
		setGridLabel(state)
	end

	-- class functions
	
	function library:SelectPage(page, toggle)
		
		if toggle and self.focusedPage == page then -- already selected
			return
		end
		
		local button = page.button
		
		if toggle then
			-- page button
			button.Title.TextTransparency = 0
			button.Title.Font = Enum.Font.GothamSemibold
			
			if button:FindFirstChild("Icon") then
				button.Icon.ImageTransparency = 0
			end
			
			-- update selected page
			local focusedPage = self.focusedPage
			self.focusedPage = page
			
			if focusedPage then
				self:SelectPage(focusedPage)
			end
			
			-- sections
			local existingSections = focusedPage and #focusedPage.sections or 0
			local sectionsRequired = #page.sections - existingSections
			
			page:Resize()
			
			for i, section in pairs(page.sections) do
				section.container.Parent.ImageTransparency = 0
			end
			
			if sectionsRequired < 0 then -- "hides" some sections
				for i = existingSections, #page.sections + 1, -1 do
					local section = focusedPage.sections[i].container.Parent
					
					utility:Tween(section, {ImageTransparency = 1}, 0.1)
				end
			end
			
			task.wait(0.1)
			page.container.Visible = true
			
			if focusedPage then
				focusedPage.container.Visible = false
			end
			
			if sectionsRequired > 0 then -- "creates" more section
				for i = existingSections + 1, #page.sections do
					local section = page.sections[i].container.Parent
					
					section.ImageTransparency = 1
					utility:Tween(section, {ImageTransparency = 0}, 0.05)
				end
			end
			
			task.wait(0.05)
			
			for i, section in pairs(page.sections) do

				utility:Tween(section.container.Title, {TextTransparency = 0}, 0.1)
				if section.container.Title:FindFirstChild("Icon") then
					utility:Tween(section.container.Title.Icon, {ImageTransparency = 0}, 0.1)
				end
				section:Resize(true)
				
				task.wait(0.05)
			end
			
			task.wait(0.05)
			page:Resize(true)
		else
			-- page button
			button.Title.Font = Enum.Font.Gotham
			button.Title.TextTransparency = 0.65
			
			if button:FindFirstChild("Icon") then
				button.Icon.ImageTransparency = 0.65
			end
			
			-- sections
			for i, section in pairs(page.sections) do	
				utility:Tween(section.container.Parent, {Size = UDim2.new(1, -10, 0, 28)}, 0.1)
				utility:Tween(section.container.Title, {TextTransparency = 1}, 0.1)
				if section.container.Title:FindFirstChild("Icon") then
					utility:Tween(section.container.Title.Icon, {ImageTransparency = 1}, 0.1)
				end
			end
			
			task.wait(0.1)
			
			page.lastPosition = utility:GetScrollTarget(page.container)
			page:Resize()
		end
	end
	
	function page:Resize(scroll)
		local padding = 10
		local size = 0
		local scale = utility:GetScale(self.container)

		for i, section in pairs(self.sections) do
			size = size + section.container.Parent.AbsoluteSize.Y / scale + padding
		end

		self.container.CanvasSize = UDim2.new(0, 0, 0, size)
		self.container.ScrollBarImageTransparency = (size > self.container.AbsoluteSize.Y / scale) and 0 or 1 -- shown only when it can scroll
		
		if scroll then
			utility:Tween(self.container, {CanvasPosition = Vector2.new(0, self.lastPosition or 0)}, 0.2)
		end
	end
	
	function section:Resize(smooth)
	
		if self.page.library.focusedPage ~= self.page then
			return
		end
		
		local padding = 4
		local scale = utility:GetScale(self.container)
		local size = (4 * padding) + self.container.Title.AbsoluteSize.Y / scale -- offset

		for i, module in pairs(self.modules) do
			size = size + module.AbsoluteSize.Y / scale + padding
		end
		
		if smooth then
			utility:Tween(self.container.Parent, {Size = UDim2.new(1, -10, 0, size)}, 0.05)
		else
			self.container.Parent.Size = UDim2.new(1, -10, 0, size)
			self.page:Resize()
		end
	end
	
	-- Scroll the page just far enough to show `module` at its finished `height` (offsets), e.g. a dropdown that's
	-- opening below the fold. The page's canvas grows while the dropdown tweens (0.3s), so the scroll holds its
	-- target that long. A module taller than the page keeps its top in view.
	function section:ScrollIntoView(module, height)
		if self.page.library.focusedPage ~= self.page then
			return
		end

		-- CanvasPosition is in screen pixels (UIScale included), so everything here is too
		local container = self.page.container
		local scale = utility:GetScale(container)
		local margin = 8 * scale
		local view = utility:GetScrollTarget(container)
		local window = container.AbsoluteWindowSize.Y
		local top = module.AbsolutePosition.Y - container.AbsolutePosition.Y + container.CanvasPosition.Y
		local bottom = top + height * scale + margin

		if bottom > view + window then
			utility:ScrollTo(container, math.min(bottom - window, top - margin), 0.35)
		end
	end

	function section:getModule(info)
	
		if table.find(self.modules, info) then
			return info
		end
		
		for i, module in pairs(self.modules) do
			local label = module:FindFirstChild("Title") or module:FindFirstChild("TextBox", true)
				or module:FindFirstChildWhichIsA("TextLabel") -- addText names its label after the text
			if label and label.Text == info then
				return module
			end
		end
		
		error("No module found under "..tostring(info))
	end
	
	-- updates
	
	function section:updateButton(button, title)
		button = self:getModule(button)
		
		button.Title.Text = title
	end
	
	-- Never yields: the second half of the animation is scheduled instead of waited for, so a click's callback runs
	-- straight away. instant: jump to the end state (building the menu)
	function section:updateToggle(toggle, title, value, instant)
		toggle = self:getModule(toggle)

		local position = {
			In = UDim2.new(0, 2, 0.5, -6),
			Out = UDim2.new(0, 20, 0.5, -6)
		}

		local frame = toggle.Button.Frame
		self.toggles[toggle] = value and true or false
		value = value and "Out" or "In"

		if title then
			toggle.Title.Text = title
		end

		if instant then
			frame.Size = UDim2.new(1, -22, 1, -4)
			frame.Position = position[value]
			return
		end

		utility:Tween(frame, {
			Size = UDim2.new(1, -22, 1, -9),
			Position = position[value] + UDim2.new(0, 0, 0, 2.5)
		}, 0.2)

		task.delay(0.1, function()
			utility:Tween(frame, {
				Size = UDim2.new(1, -22, 1, -4),
				Position = position[value]
			}, 0.1)
		end)
	end
	
	function section:updateStatus(status, value, title)
		status = self:getModule(status)

		if title then
			status.Title.Text = title
		end

		status.Value.Text = tostring(value)
	end

	function section:updateTextbox(textbox, title, value)
		textbox = self:getModule(textbox)
		
		if title then
			textbox.Title.Text = title
		end
		
		if value then
			textbox.Button.Textbox.Text = value
		end
		
	end
	
	function section:updateKeybind(keybind, title, key)
		keybind = self:getModule(keybind)
		
		local text = keybind.Button.Text
		local bind = self.binds[keybind]
		
		if title then
			keybind.Title.Text = title
		end
		
		if bind.connection then
			bind.connection = bind.connection:UnBind()
		end
			
		if key then
			self.binds[keybind].connection = utility:BindToKey(key, bind.callback)
			text.Text = key.Name
		else
			text.Text = "None"
		end
	end
	
	function section:updateColorPicker(colorpicker, title, color)
		colorpicker = self:getModule(colorpicker)
		
		local picker = self.colorpickers[colorpicker]
		local tab = picker.tab
		local callback = picker.callback
		
		if title then
			colorpicker.Title.Text = title
			tab.Title.Text = title
		end
		
		local color3
		local hue, sat, brightness
		
		if type(color) == "table" then -- roblox is literally retarded x2
			hue, sat, brightness = unpack(color)
			color3 = Color3.fromHSV(hue, sat, brightness)
		else
			color3 = color
			hue, sat, brightness = Color3.toHSV(color3)
		end
		
		utility:Tween(colorpicker.Button, {ImageColor3 = color3}, 0.5)
		utility:Tween(tab.Container.Color.Select, {Position = UDim2.new(hue, 0, 0, 0)}, 0.1)
		
		utility:Tween(tab.Container.Canvas, {ImageColor3 = Color3.fromHSV(hue, 1, 1)}, 0.5)
		utility:Tween(tab.Container.Canvas.Cursor, {Position = UDim2.new(sat, 0, 1 - brightness)}, 0.5)
		
		for i, container in pairs(tab.Container.Inputs:GetChildren()) do
			if container:IsA("ImageLabel") then
				local value = math.clamp(color3[container.Name], 0, 1) * 255
				
				container.Textbox.Text = math.floor(value)
				--callback(container.Name:lower(), value)
			end
		end
	end
	
	-- `value` nil: take it from the mouse (dragging). `min`/`max` nil: keep the slider's own.
	function section:updateSlider(slider, title, value, min, max, lvalue)
		slider = self:getModule(slider)
		local options = self.sliders[slider]

		if title then
			slider.Title.Text = title
		end

		options.min, options.max = min or options.min, max or options.max
		min, max = options.min, options.max

		local bar = slider.Slider.Bar
		local percent = (mouse.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X

		if value then -- support negative ranges
			percent = max > min and (value - min) / (max - min) or 0
			value = roundSlider(options, value) -- typed values aren't snapped to the step, only trimmed to its decimals
		end

		percent = math.clamp(percent, 0, 1)
		value = value or roundSlider(options, min + math.floor((max - min) * percent / options.step + 0.5) * options.step)

		if not slider.TextBox:IsFocused() then
			slider.TextBox.Text = formatSlider(options, value)
		end
		utility:Tween(bar.Fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.1)
		
		if value ~= lvalue and slider.ImageTransparency == 0 then
			utility:Pop(slider, 10)
		end

		options.value = value
		return value
	end
	
	-- Rebuild an open dropdown's rows from `shown`, or close it when `shown` is nil. An empty `shown` opens with a
	-- "Nothing found" row.
	local function renderDropdown(self, dropdown, state, shown, quiet)
		local frame = dropdown.List.Frame
		local search = dropdown.Search

		state.open = shown ~= nil

		if not quiet then
			utility:Pop(search, 10)
		end

		for i, child in pairs(frame:GetChildren()) do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end

		local rows = 0

		for i, value in pairs(shown or {}) do
			local button = createDropdownRow(frame, value, state.kind)

			if state.kind == "multi" then
				button.Check.Fill.Visible = table.find(state.selected, value) ~= nil
			end

			button.MouseButton1Click:Connect(function()
				if state.kind == "multi" then
					-- toggle it, keeping the picks in list order (anything no longer listed goes last)
					local picked = table.find(state.selected, value) == nil
					local set = {}
					for _, v in ipairs(state.selected) do
						set[v] = true
					end
					set[value] = picked or nil

					local ordered = {}
					for _, v in ipairs(state.list) do
						if set[v] then
							table.insert(ordered, v)
							set[v] = nil
						end
					end
					for _, v in ipairs(state.selected) do
						if set[v] then
							table.insert(ordered, v)
						end
					end

					state.selected = ordered
					button.Check.Fill.Visible = picked
					if not search.TextBox:IsFocused() then
						search.TextBox.Text = dropdownLabel(state)
					end

					if state.callback then
						state.callback(table.clone(ordered), function(...)
							self:updateMultiDropdown(dropdown, ...)
						end)
					end
					return
				end

				if state.callback then
					state.callback(value, function(...)
						self:updateDropdown(dropdown, ...)
					end)
				end

				if state.kind == "list" then
					self:updateDropdown(dropdown, nil, nil)
					search.TextBox.Text = state.title
				else
					self:updateDropdown(dropdown, value, nil)
				end
			end)

			rows = rows + 1
		end

		if rows == 0 and shown then
			createDropdownRow(frame, "Nothing found", "placeholder")
			rows = 1
		end

		local height = (rows == 0 and 30) or math.clamp(rows, 0, 3) * 34 + 38
		utility:Tween(dropdown, {Size = UDim2.new(1, 0, 0, height)}, 0.3)
		utility:Tween(search.Button, {Rotation = shown and 180 or 0}, 0.3)
		if rows > 0 and not quiet then
			self:ScrollIntoView(dropdown, height)
		end

		if not quiet then
			frame.CanvasPosition = Vector2.new(0, 0) -- new contents start at the top
		end

		if rows > 3 then
			for i, row in pairs(frame:GetChildren()) do
				if row:IsA("GuiObject") then
					row.Size = UDim2.new(1, -6, 0, 30) -- room for the scrollbar
				end
			end

			frame.CanvasSize = UDim2.new(0, 0, 0, (rows * 34) - 4)
			frame.ScrollBarImageTransparency = 0
		else
			frame.CanvasSize = UDim2.new(0, 0, 0, 0)
			frame.ScrollBarImageTransparency = 1
		end
	end

	-- Open the dropdown showing `list` (it doesn't replace the dropdown's own list; see setDropdownList), or close it
	-- when `list` is nil. `title` replaces the text in the box (for an addList or addMultiDropdown, its title).
	-- `callback`, if given, replaces the one it was made with.
	function section:updateDropdown(dropdown, title, list, callback)
		dropdown = self:getModule(dropdown)
		local state = self.dropdowns[dropdown]

		if callback then
			state.callback = callback
		end

		if title then
			if state.kind ~= "dropdown" then
				state.title = title
				title = dropdownLabel(state)
			end
			dropdown.Search.TextBox.Text = title
		end

		renderDropdown(self, dropdown, state, list)
	end

	function section:updateList(dropdown, title, list, callback)
		return self:updateDropdown(dropdown, title, list, callback)
	end

	-- Replace the list the dropdown opens with (or, with no `list`, pick up changes made to the same table). If it's
	-- open it updates in place, keeping your search and scroll.
	function section:setDropdownList(dropdown, list)
		dropdown = self:getModule(dropdown)
		local state = self.dropdowns[dropdown]

		state.list = list or state.list

		if state.open then
			local search = dropdown.Search.TextBox
			local shown = search:IsFocused() and utility:Sort(search.Text, state.list) or state.list
			renderDropdown(self, dropdown, state, shown, true)
		end
	end

	-- Set what a multi dropdown has picked (an array), without calling its callback.
	function section:updateMultiDropdown(dropdown, selected)
		dropdown = self:getModule(dropdown)
		local state = self.dropdowns[dropdown]

		state.selected = table.clone(selected or {})

		local search = dropdown.Search.TextBox
		if not search:IsFocused() then
			search.Text = dropdownLabel(state)
		end

		for i, row in pairs(dropdown.List.Frame:GetChildren()) do
			if row:FindFirstChild("Check") then
				row.Check.Fill.Visible = table.find(state.selected, row.Title.Text) ~= nil
			end
		end
	end

end

return library;

