	-- Toasts: notifications without buttons that close themselves after `duration` seconds (default 4), or when
	-- clicked. They don't wait in line like Notify; they stack up from the bottom-right corner, newest at the bottom,
	-- at most five at a time.
	local toastWidth, toastGap, toastLimit = 260, 8, 5

	local function layoutToasts(self)
		local y = 10
		for i = #self.toasts, 1, -1 do
			local toast = self.toasts[i]
			utility:Tween(toast, {Position = UDim2.new(1, -10, 1, -y)}, 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			y = y + toast.Size.Y.Offset + toastGap
		end
	end

	local function dismissToast(self, toast)
		local index = table.find(self.toasts, toast)
		if not index then
			return
		end
		table.remove(self.toasts, index)
		layoutToasts(self)

		utility:Tween(toast, {Position = toast.Position + UDim2.new(0, toastWidth + 20, 0, 0)}, 0.2)
		task.delay(0.2, function()
			toast:Destroy()
		end)
	end

	function library:Toast(title, text, duration)
		self.toasts = self.toasts or {}
		title = title or "Notification"
		text = text or ""
		duration = duration or 4

		local textHeight = game:GetService("TextService"):GetTextSize(text, 12, Enum.Font.Gotham, Vector2.new(toastWidth - 20, math.huge)).Y
		local height = 28 + textHeight + 12

		local toast = utility:Create("ImageButton", {
