do
	function utility:Create(instance, properties, children)
		local object = Instance.new(instance)
		
		for i, v in pairs(properties or {}) do
			object[i] = v

			-- remember theme-colored properties so setTheme can recolor them later
			if typeof(v) == "Color3" then
				for theme, color in pairs(themes) do
					if color == v then
						objects[theme] = objects[theme] or {}
						objects[theme][i] = objects[theme][i] or setmetatable({}, {__mode = "k"})
						objects[theme][i][object] = true
					end
				end
			end
		end
		
		for i, module in pairs(children or {}) do
			module.Parent = object
		end
		
		return object
	end
	
	function utility:Tween(instance, properties, duration, ...)
		tween:Create(instance, tweeninfo(duration, ...), properties):Play()
	end
	
	function utility:Wait()
		run.RenderStepped:Wait()
		return true
	end

	function utility:Sort(pattern, values)
		local new = {}
		pattern = pattern:lower()
		
		if pattern == "" then
			return values
		end
		
		for i, value in pairs(values) do
			if tostring(value):lower():find(pattern, 1, true) then -- plain: "(" or "[" in a search isn't a pattern
				table.insert(new, value)
			end
		end
		
		return new
	end
	
	function utility:Pop(object, shrink)
		local clone = object:Clone()
		
		clone.AnchorPoint = Vector2.new(0.5, 0.5)
		clone.Size = clone.Size - UDim2.new(0, shrink, 0, shrink)
		clone.Position = UDim2.new(0.5, 0, 0.5, 0)
		
		-- Make ALL clones non-interactive, always
		clone.Active = false
		if clone:IsA("GuiButton") then
			clone.AutoButtonColor = false
		end
		
		clone.Parent = object
		clone:ClearAllChildren()
		
		object.ImageTransparency = 1
		utility:Tween(clone, {Size = object.Size}, 0.2)
		
		task.delay(0.2, function()
			if clone and clone.Parent then
				object.ImageTransparency = 0
				clone:Destroy()
			end
		end)
		
		return clone
	end
	
	-- These listen on UserInputService, so they'd outlive the window; they're dropped when `container` is destroyed
	-- (a re-run's old binds kept firing alongside the new ones)
	function utility:InitializeKeybind(container)
		self.keybinds = {}
		self.ended = {}

		local began = input.InputBegan:Connect(function(key, processed)
			if processed then -- typing in chat or a textbox
				return
			end
			if self.keybinds[key.KeyCode] then
				for i, bind in pairs(self.keybinds[key.KeyCode]) do
					bind()
				end
			end
		end)

		local ended = input.InputEnded:Connect(function(key)
			if key.UserInputType == Enum.UserInputType.MouseButton1 then
				for i, callback in pairs(self.ended) do
					callback()
				end
			end
		end)

		container.Destroying:Connect(function()
			began:Disconnect()
			ended:Disconnect()
			self.keybinds = {}
			self.ended = {}
		end)
	end
	
	function utility:BindToKey(key, callback)
		 
		self.keybinds[key] = self.keybinds[key] or {}
		
		table.insert(self.keybinds[key], callback)
		
		return {
			UnBind = function()
				for i, bind in pairs(self.keybinds[key]) do
					if bind == callback then
						table.remove(self.keybinds[key], i)
					end
				end
			end
		}
	end
	
	function utility:KeyPressed() -- yield until next key is pressed
		local key = input.InputBegan:Wait()
		
		while key.UserInputType ~= Enum.UserInputType.Keyboard	 do
			key = input.InputBegan:Wait()
		end
		
		task.wait() -- overlapping connection
		
		return key
	end
	
	function utility:DraggingEnabled(frame, parent)
	
		parent = parent or frame
		
		-- stolen from wally or kiriot, kek
		local dragging = false
		local dragInput, mousePos, framePos

		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				mousePos = input.Position
				framePos = parent.Position
				
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		frame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				dragInput = input
			end
		end)

		-- Global, so it's dropped with the frame (every notification is draggable; these used to pile up forever)
		local moved = input.InputChanged:Connect(function(input)
			if input == dragInput and dragging then
				local delta = input.Position - mousePos
				parent.Position  = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
			end
		end)
		frame.Destroying:Connect(function()
			moved:Disconnect()
		end)

	end
	
	-- The combined UIScale over an instance (its own and its ancestors'). AbsoluteSize is in screen pixels, already
	-- scaled; divide by this before writing it back into an offset Size, or the UIScale applies twice.
	function utility:GetScale(instance)
		local scale = 1
		while instance do
			local uiScale = instance:FindFirstChildOfClass("UIScale")
			if uiScale then
				scale = scale * uiScale.Scale
			end
			instance = instance.Parent
		end
		return scale
	end

	-- Smooth scrolling. Roblox applies a wheel notch instantly; each frame we catch that jump, put the canvas back
	-- where the animation is and glide toward the new spot instead (notches stack while it's still moving). Any other
	-- change (scrollbar drag, a tween, the canvas shrinking under it) is taken as-is. One RenderStepped loop serves
	-- every registered frame and disconnects once they're all destroyed.
	-- A frame registered with a `step` reads the wheel itself: each wheel event under the mouse moves it `step`, more
	-- while the wheel is flicked fast, and whatever Roblox does with the wheel (a big jump, sometimes a frame or two
	-- late, so short lists skip past what you wanted) is undone.
	local scrollers = {}
	local scrollLoop, wheelWatch
	local wheeled = 0 -- wheel notches that landed this frame (input is processed before RenderStepped)
	local wheelAccel = {
		window = 0.06, -- seconds; only a notch this soon after the last one (a fast flick) speeds up
		gain = 0.35, -- extra steps per notch for each notch in the streak
		max = 5, -- most steps one notch can move
		ignore = 0.25, -- seconds after a wheel event that Roblox's own jump is undone
	}

	-- Furthest CanvasPosition.Y. CanvasPosition is in screen pixels, UIScale included, like the Absolute sizes
	-- (dividing by the scale stopped a 120% menu about a sixth short of the bottom).
	local function maxScroll(frame)
		return math.max(0, frame.AbsoluteCanvasSize.Y - frame.AbsoluteWindowSize.Y)
	end

	-- The mouse is over `frame` where it's actually drawn: inside it and every clipping ancestor (a closed dropdown's
	-- list has no height; a dropdown scrolled off its page is clipped away)
	local function underMouse(frame)
		local x, y = mouse.X, mouse.Y
		local object = frame
		while object and object:IsA("GuiObject") do
			if not object.Visible then
				return false
			end
			if object == frame or object.ClipsDescendants or object:IsA("ScrollingFrame") then
				local position, size = object.AbsolutePosition, object.AbsoluteSize
				if x < position.X or y < position.Y or x > position.X + size.X or y > position.Y + size.Y then
					return false
				end
			end
			object = object.Parent
		end
		return true
	end

	local function wheelStepped(state, frame, z, now)
		local direction = -math.sign(z) -- wheel up (z > 0) scrolls toward the top
		if direction == 0 then
			return
		end
		if direction == state.direction and now - state.notched < wheelAccel.window then
			state.streak = state.streak + 1
		else
			state.streak = 0
		end
		state.direction, state.notched = direction, now
		-- steps are offsets; CanvasPosition is in screen pixels, which UIScale stretches
		local step = state.step * utility:GetScale(frame) * math.min(1 + state.streak * wheelAccel.gain, wheelAccel.max)
		state.target = math.clamp(state.target, 0, maxScroll(frame)) + direction * step
		state.moving = true
		state.hold = 0
		state.ignoreUntil = now + wheelAccel.ignore
	end

	local function stepScrollers(dt)
		local alpha = 1 - math.exp(-14 * dt)
		local now = os.clock()

		for frame, state in pairs(scrollers) do
			if not frame.Parent then
				scrollers[frame] = nil
				continue
			end

			local y = frame.CanvasPosition.Y
			if math.abs(y - state.last) > 0.01 then
				if state.step and now < state.ignoreUntil then
					-- Roblox's own wheel jump: put it back (the glide below moves it from there)
					frame.CanvasPosition = Vector2.new(frame.CanvasPosition.X, state.current)
					state.last = frame.CanvasPosition.Y
				elseif wheeled > 0 and not state.step then
					state.target = math.clamp(state.target, 0, maxScroll(frame)) + (y - state.last)
					state.moving = true
				else
					state.current, state.target, state.last = y, y, y
					state.hold, state.moving = 0, false
				end
			end

			if state.moving then
				local goal = math.clamp(state.target, 0, maxScroll(frame))
				if math.abs(goal - state.current) < 0.5 then
					state.current = goal
					if now >= state.hold then -- ScrollTo keeps chasing its target while the canvas grows into it
						state.target, state.moving = goal, false
					end
				else
					state.current = state.current + (goal - state.current) * alpha
				end
				frame.CanvasPosition = Vector2.new(frame.CanvasPosition.X, state.current)
				state.last = frame.CanvasPosition.Y
			end
		end

		wheeled = 0
	end

	-- `step` (offsets per wheel notch) is optional; without it a notch moves as far as Roblox would
	function utility:SmoothScroll(frame, step)
		local y = frame.CanvasPosition.Y
		scrollers[frame] = {current = y, target = y, last = y, hold = 0, moving = false,
			step = step, direction = 0, notched = 0, streak = 0, ignoreUntil = 0}

		if not scrollLoop then
			wheelWatch = input.InputChanged:Connect(function(inputObject)
				if inputObject.UserInputType ~= Enum.UserInputType.MouseWheel then
					return
				end
				wheeled = wheeled + 1
				local now = os.clock()
				for steppedFrame, state in pairs(scrollers) do
					if state.step and steppedFrame.Parent and underMouse(steppedFrame) then
						wheelStepped(state, steppedFrame, inputObject.Position.Z, now)
					end
				end
			end)
			scrollLoop = run.RenderStepped:Connect(function(dt)
				stepScrollers(dt)
				if next(scrollers) == nil then
					scrollLoop:Disconnect()
					wheelWatch:Disconnect()
					scrollLoop, wheelWatch = nil, nil
				end
			end)
		end

		frame.Destroying:Connect(function()
			scrollers[frame] = nil
		end)
	end

	-- Glide `frame` to CanvasPosition.Y = `y`. For `hold` seconds it keeps aiming there even if the canvas is still
	-- too short, so it follows a dropdown that's tweening open.
	function utility:ScrollTo(frame, y, hold)
		local state = scrollers[frame]
		if not state then
			frame.CanvasPosition = Vector2.new(frame.CanvasPosition.X, y)
			return
		end
		state.target = math.max(0, y)
		state.hold = os.clock() + (hold or 0)
		state.moving = true
	end

	-- Where `frame` is headed (CanvasPosition.Y lags behind while it's gliding)
	function utility:GetScrollTarget(frame)
		local state = scrollers[frame]
		if state and state.moving then
			return math.clamp(state.target, 0, maxScroll(frame))
		end
		return frame.CanvasPosition.Y
	end

	-- Drag `grip` to resize `frame` (offset sizes). Mouse movement is divided by the frame's UIScale, if it has one,
	-- so the corner stays under the mouse at any scale.
	function utility:ResizingEnabled(grip, frame, minSize)
		local resizing = false
		local startMouse, startSize

		grip.InputBegan:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = true
				startMouse = inputObject.Position
				startSize = Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset)

				inputObject.Changed:Connect(function()
					if inputObject.UserInputState == Enum.UserInputState.End then
						resizing = false
					end
				end)
			end
		end)

		local moved
		moved = input.InputChanged:Connect(function(inputObject)
			if not grip.Parent then
				moved:Disconnect()
				return
			end
			if resizing and inputObject.UserInputType == Enum.UserInputType.MouseMovement then
				local uiScale = frame:FindFirstChildOfClass("UIScale")
				local scale = uiScale and uiScale.Scale or 1
				local delta = inputObject.Position - startMouse
				frame.Size = UDim2.new(
					0, math.max(minSize.X, startSize.X + delta.X / scale),
					0, math.max(minSize.Y, startSize.Y + delta.Y / scale)
				)
			end
		end)
	end

	function utility:DraggingEnded(callback)
		table.insert(self.ended, callback)
	end
	
end

